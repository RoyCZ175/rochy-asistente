# Configuración del asistente de voz tipo Jarvis / Iron Man
# Copia este archivo a .env y rellena tus valores reales

# Clave de Groq (gratis en https://console.groq.com/keys)
GROQ_API_KEY=***REMOVED_GROQ_KEY***

# Modelo de chat de Groq (soporta function calling).
# Verifica los modelos disponibles con tu clave en https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Modelo de Groq para transcripción de voz (Whisper)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Voz de Edge TTS (gratis). Prueba otras con: edge-tts --list-voices
EDGE_TTS_VOICE=es-ES-AlvaroNeural

# Idioma para el reconocimiento de voz
VOICE_LANGUAGE=es-ES

# Nombre del asistente
ASSISTANT_NAME=Rochy

# Palabra clave de activación (el asistente escucha en segundo plano
# y solo procesa el comando cuando detecta esta palabra). También puedes
# escribirle directamente en el cuadro de texto de la interfaz sin necesitar
# la palabra clave.
WAKE_WORD=rochy

# Spotify (opcional, solo si quieres controlar música por voz).
# Crea una app en https://developer.spotify.com/dashboard con
# Redirect URI = http://127.0.0.1:8888/callback
# Requiere cuenta Spotify Premium para controlar la reproducción.
SPOTIFY_CLIENT_ID=***REMOVED_SPOTIFY_CLIENT_ID***
SPOTIFY_CLIENT_SECRET=***REMOVED_SPOTIFY_CLIENT_SECRET***
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Plataforma universitaria (opcional, modo tutor de solo lectura).
# Corre `python university_login.py` una vez (inicias sesión tú mismo, con
# Google/2FA si aplica) para generar university_session.json y este valor.
UNIVERSITY_BASE_URL=

# Google Calendar + Gmail (opcional).
# 1) Crea un proyecto en https://console.cloud.google.com, activa Calendar API y Gmail API.
# 2) Pantalla de consentimiento OAuth: tipo Externo, agrégate como usuario de prueba,
#    y cambia el estado a "En producción" para que el acceso no expire cada 7 días.
# 3) Credenciales > Crear credenciales > ID de cliente de OAuth > Aplicación de escritorio.
# 4) Descarga el JSON y guárdalo como google_credentials.json en la carpeta del proyecto.
GOOGLE_CREDENTIALS_PATH=google_credentials.json

# IA local de respaldo, sin internet (opcional pero recomendado).
# 1) Instala Ollama: https://ollama.com/download (instalador normal de Windows)
# 2) En una terminal: ollama pull llama3.2
# 3) Déjalo con el nombre por defecto o cambia el modelo aquí.
OLLAMA_MODEL=llama3.2
